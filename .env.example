# ====== ❗ 把本文件复制为 .env 并填值，.env 已在 .gitignore 中忽略，不会提交到版本库 ======
# 用法：
#   cp .env.example .env
#   编辑 .env 填上真实凭据
#   docker compose --env-file .env up -d --build
#
# 说明：
#   - dev 环境（默认）允许部分留空走兜底默认值
#   - prod 环境启动时 AppStartupGuard 会强校验，任何弱/空凭据将拒绝启动

# ====== PostgreSQL ======
# 数据库密码（必填，生产必须强密码）
PG_PASSWORD=

# 对外映射端口（默认 5434，避免与宿主机 5432 冲突）
# PG_PUBLISH_PORT=5434

# ====== MinIO ======
# MinIO 管理员凭据（必填，禁止 minioadmin 等默认值）
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

# MinIO 桶名（默认 music）
# MINIO_BUCKET=music

# 对外映射端口（默认 9500/9501，避免与已有 MinIO 冲突）
# MINIO_PUBLISH_PORT=9500
# MINIO_CONSOLE_PUBLISH_PORT=9501

# 文件外链域名（可选；不填时落库 url = "<bucket>/<key>" 相对路径，由前端自行拼域名）
# 示例：MINIO_DOMAIN=https://files.example.com/
# MINIO_DOMAIN=

# ====== 应用 ======
# admin 首次初始化密码（必填，仅首次建账号时生效；后续启动不会重置）
SYSTEM_INIT_PASSWORD=

# Spring Profile（默认 dev，生产填 prod）
# SPRING_PROFILES_ACTIVE=prod
